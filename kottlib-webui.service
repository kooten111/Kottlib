[Unit]
Description=Kottlib Web UI
After=network.target kottlib-backend.service
Wants=kottlib-backend.service

[Service]
Type=simple
User=kooten
WorkingDirectory=/mnt/Server/kottlib/webui
Environment=PATH=/usr/local/bin:/usr/bin:/bin
Environment=PORT=5173
Environment=HOST=0.0.0.0
Environment=BACKEND_URL=http://127.0.0.1:8081
# Optional: set to a LAN-reachable backend URL so cover <img> requests skip the Node proxy
# Environment=PUBLIC_BACKEND_URL=http://192.168.2.5:8081
ExecStart=/usr/local/bin/bun build/index.js
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
